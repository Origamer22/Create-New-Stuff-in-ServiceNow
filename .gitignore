# Python Virtual Environments
.venv/
venv/
ENV/

# VS Code Configuration (completely hidden)
.vscode/

# Secrets & Environment Files
# (Hides .env, details_of_instances_dev_snow.env, and all .env variations)
.env
details_of_instances_dev_snow.env
*.env
*.env.*
*.env*
*.ENV
*.ENV.*

